{
  "name": "@tobiasoberpaul/mdk",
  "version": "0.1.1",
  "type": "module",
  "files": [
    "dist",
    "docs/LIBRARY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./motion.css": "./dist/styles/motion.css"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-css.mjs",
    "build:examples": "node scripts/build-db-react.mjs && node scripts/build-shadcn.mjs",
    "build:shadcn": "node scripts/build-shadcn.mjs",
    "analytics": "node context-starter/analytics/serve.mjs . --codex-history",
    "dev": "npm run build && npm run build:examples && node scripts/serve.mjs",
    "test": "npm run build && npm run build:examples && playwright test",
    "build:site": "npm run build && npm run build:examples && node scripts/build-site.mjs",
    "mcp": "node ai/mcp-server.mjs",
    "prepack": "npm run build",
    "check:mcp": "node scripts/check-mcp.mjs"
  },
  "devDependencies": {
    "@db-ux/core-components": "6.2.0",
    "@db-ux/core-foundations": "6.2.0",
    "@db-ux/db-theme": "7.2.0",
    "@db-ux/react-core-components": "6.2.0",
    "@playwright/test": "1.48.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.21.5",
    "lucide-react": "1.66.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "picomatch": "4.0.7"
  },
  "description": "Framework-independent, reversible UI motion with CSS tokens and the Web Animations API.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TOberpaul/animations.git"
  },
  "bugs": {
    "url": "https://github.com/TOberpaul/animations/issues"
  },
  "keywords": [
    "animation",
    "motion",
    "waapi",
    "typescript",
    "design-system"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],

  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
